PORT=5001
NODE_ENV=production
TEMP_DIR=/tmp/oj-jobs

# Must match EXECUTION_SERVICE_TOKEN in the backend (.env locally, SSM in AWS)
EXECUTION_SERVICE_TOKEN=replace_with_same_token_as_backend

# Limits (milliseconds / bytes)
COMPILE_TIMEOUT_MS=20000
RUN_TIMEOUT_MS=5000
MAX_OUTPUT_BYTES=1000000

# Exit after N idle minutes (0 = never). Set to 15 on ECS so orphaned runners stop themselves.
IDLE_EXIT_MINUTES=0
