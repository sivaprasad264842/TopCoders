{
    "name": "topcoders-runner",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "main": "server.js",
    "description": "Sandboxed code execution service for TopCoders (C++, Java, Python, JavaScript).",
    "scripts": {
        "start": "node server.js",
        "test": "node --test test/unit.test.js",
        "test:docker": "node test/smoke.mjs",
        "docker:build": "docker build -t topcoders-runner .",
        "docker:run": "docker run --rm --init --name topcoders-runner -p 5001:5001 --cpus=1 --memory=1g --pids-limit=256 -e EXECUTION_SERVICE_TOKEN=local-dev-token topcoders-runner"
    },
    "engines": {
        "node": ">=22"
    },
    "license": "ISC",
    "dependencies": {
        "express": "^5.2.1"
    }
}
