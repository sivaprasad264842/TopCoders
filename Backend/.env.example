PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string
# Find: Atlas dashboard > your cluster > Connect > Drivers > copy the connection string
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/topcoders

# Long random secret for signing JWT tokens
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_long_random_secret

# Comma-separated frontend origins allowed by CORS
CLIENT_URL=https://topcoders.online,https://www.topcoders.online

# Gmail address and its App Password (NOT your regular Gmail password)
# Generate App Password: Google Account > Security > 2-Step Verification > App Passwords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx

# On ECS Fargate both containers share localhost — do not change this value
# For local docker-compose this is automatically overridden in docker-compose.yml
EXECUTION_SERVICE_URL=http://127.0.0.1:5001/execute

# Shared secret between backend and runner — must match the value in AWS SSM
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXECUTION_SERVICE_TOKEN=replace_with_long_random_token

# OpenAI API key — find at platform.openai.com/api-keys
# Leave blank or remove to disable the AI analysis feature
OPENAI_API_KEY=sk-replace_me
OPENAI_MODEL=gpt-4o-mini