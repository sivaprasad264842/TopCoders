# Copy to Backend/.env for local development (`npm run dev`).
# In AWS these come from the ECS task definition + SSM Parameter Store instead.

PORT=5000
NODE_ENV=development

# MongoDB Atlas: cluster > Connect > Drivers > copy the connection string
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/topcoders

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_long_random_secret

# Comma-separated frontend origins allowed by CORS (the first one is used in email links)
CLIENT_URL=http://localhost:5173

# Email (pick one; with neither, dev mode prints the verification link to the console)
RESEND_API_KEY=
EMAIL_FROM=TopCoders <support@topcoders.online>
EMAIL_USER=
EMAIL_PASS=

# Optional: AI code review (leave empty to disable)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Code runner ─────────────────────────────────────────────────────────────
# static = one shared runner at RUNNER_URL (local: cd container && npm run docker:run)
# ecs    = one Fargate task per active user, started/stopped on demand (production)
RUNNER_MODE=static
RUNNER_URL=http://localhost:5001
# Shared secret between backend and runner (must match the runner's value)
EXECUTION_SERVICE_TOKEN=local-dev-token

# ecs mode only
AWS_REGION=ap-south-1
ECS_CLUSTER_NAME=topcoders
ECS_RUNNER_TASK_DEF=topcoders-runner
ECS_SUBNET_IDS=subnet-XXXXXXXX,subnet-YYYYYYYY
ECS_SECURITY_GROUP_ID=sg-XXXXXXXX
RUNNER_ASSIGN_PUBLIC_IP=ENABLED
RUNNER_CAPACITY_PROVIDER=FARGATE
SESSION_IDLE_TIMEOUT_MIN=10
RUNNER_RELEASE_GRACE_SEC=60
RUNNER_START_TIMEOUT_SEC=180
MAX_ACTIVE_RUNNERS=20
