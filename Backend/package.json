{
    "name": "topcoders-backend",
    "version": "2.0.0",
    "private": true,
    "description": "TopCoders online judge API: auth, problems, submissions, AI review and on-demand code runners.",
    "main": "server.js",
    "type": "module",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon --watch server.js --watch app.js --watch config --watch controllers --watch middleware --watch models --watch routes --watch services --watch utils --ext js,json --delay 500ms server.js",
        "test": "node --test --test-concurrency=1 test/*.test.js"
    },
    "engines": {
        "node": ">=22"
    },
    "license": "ISC",
    "dependencies": {
        "@aws-sdk/client-ecs": "^3.1154.0",
        "axios": "^1.15.2",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.6",
        "dotenv": "^17.4.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.1",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.4.1",
        "nodemailer": "^8.0.5",
        "openai": "^6.35.0",
        "resend": "^6.12.4"
    },
    "devDependencies": {
        "nodemon": "^3.1.14"
    }
}
