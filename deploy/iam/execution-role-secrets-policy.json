{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTopCodersSecrets",
      "Effect": "Allow",
      "Action": ["ssm:GetParameters", "ssm:GetParameter"],
      "Resource": "arn:aws:ssm:__REGION__:__ACCOUNT_ID__:parameter/topcoders/*"
    },
    {
      "Sid": "DecryptSecureStrings",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*"
    }
  ]
}
