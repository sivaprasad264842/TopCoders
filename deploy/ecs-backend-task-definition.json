{
  "family": "topcoders-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::__ACCOUNT_ID__:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::__ACCOUNT_ID__:role/topcoders-backend-task-role",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "__BACKEND_IMAGE__",
      "essential": true,
      "portMappings": [{ "containerPort": 5000, "protocol": "tcp", "appProtocol": "http" }],
      "environment": [
        { "name": "NODE_ENV",                 "value": "production" },
        { "name": "PORT",                     "value": "5000" },
        { "name": "CLIENT_URL",               "value": "__CLIENT_URL__" },
        { "name": "OPENAI_MODEL",             "value": "gpt-4o-mini" },
        { "name": "AWS_REGION",               "value": "__REGION__" },
        { "name": "RUNNER_MODE",              "value": "ecs" },
        { "name": "ECS_CLUSTER_NAME",         "value": "__CLUSTER__" },
        { "name": "ECS_RUNNER_TASK_DEF",      "value": "topcoders-runner" },
        { "name": "ECS_SUBNET_IDS",           "value": "__SUBNET_IDS__" },
        { "name": "ECS_SECURITY_GROUP_ID",    "value": "__RUNNER_SG__" },
        { "name": "RUNNER_ASSIGN_PUBLIC_IP",  "value": "ENABLED" },
        { "name": "RUNNER_CAPACITY_PROVIDER", "value": "__CAPACITY_PROVIDER__" },
        { "name": "SESSION_IDLE_TIMEOUT_MIN", "value": "10" },
        { "name": "MAX_ACTIVE_RUNNERS",       "value": "__MAX_RUNNERS__" }
      ],
      "secrets": [
        { "name": "MONGO_URI",               "valueFrom": "arn:aws:ssm:__REGION__:__ACCOUNT_ID__:parameter/topcoders/MONGO_URI" },
        { "name": "JWT_SECRET",              "valueFrom": "arn:aws:ssm:__REGION__:__ACCOUNT_ID__:parameter/topcoders/JWT_SECRET" },
        { "name": "EMAIL_USER",              "valueFrom": "arn:aws:ssm:__REGION__:__ACCOUNT_ID__:parameter/topcoders/EMAIL_USER" },
        { "name": "EMAIL_PASS",              "valueFrom": "arn:aws:ssm:__REGION__:__ACCOUNT_ID__:parameter/topcoders/EMAIL_PASS" },
        { "name": "RESEND_API_KEY",          "valueFrom": "arn:aws:ssm:__REGION__:__ACCOUNT_ID__:parameter/topcoders/RESEND_API_KEY" },
        { "name": "OPENAI_API_KEY",          "valueFrom": "arn:aws:ssm:__REGION__:__ACCOUNT_ID__:parameter/topcoders/OPENAI_API_KEY" },
        { "name": "EXECUTION_SERVICE_TOKEN", "valueFrom": "arn:aws:ssm:__REGION__:__ACCOUNT_ID__:parameter/topcoders/EXECUTION_SERVICE_TOKEN" }
      ],
      "stopTimeout": 15,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/topcoders",
          "awslogs-region": "__REGION__",
          "awslogs-stream-prefix": "backend"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "node -e \"fetch('http://127.0.0.1:5000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      }
    }
  ]
}
